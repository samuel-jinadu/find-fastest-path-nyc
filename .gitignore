scripts/push.sh
scripts

# ─── Airflow ────────────────────────────────────────────────────────────────
# Runtime artifacts that get regenerated every time the stack starts.
logs/
config/airflow.cfg
config/webserver_config.py
airflow.db
airflow.cfg
unittests.cfg
*.pid
*.lock

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ─── Environment / secrets ──────────────────────────────────────────────────
# Never commit real credentials. compose.override.yaml currently holds
# example values, but keep a .env for anything sensitive going forward.
.env
.env.*
!.env.example
*.pem
*.key

# ─── Data volumes (if mounted locally) ──────────────────────────────────────
data/
minio-data/
locals3-data/
*.parquet
*.csv
*.json
!dags/**/*.json

# Explicitly keep devcontainer settings IMPORTANT for docker networking issues
!.devcontainer/devcontainer.json


# Explicitly keep anything that's actually part of the codebase
!dags/**/*.py
!src/**/*.py
!services/**/requirements.txt

# ─── IDE / editors ──────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*.sublime-*
*.code-workspace

# Keep shared VS Code settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

